# ==========================================
# GeminiFlow Environment Configuration
# ==========================================

# ------------------------------------------
# 1. 系統設定 (System Settings)
# ------------------------------------------

# 是否啟用偵錯模式 (Enable debug mode)
# 開啟後會輸出大量底層的連線日誌與解析過程。
# 可選選項 (Options): true, false, 1, 0, yes, no
# 預設 (Default): false
DEBUG=false

# ------------------------------------------
# 2. 路徑設定 (Path Settings)
# ------------------------------------------

# Cookie 存放目錄 (Directory to store Playwright profile and cookies)
# Playwright 的 profile (.pw-profile) 與 auth JSON 會儲存於此。
# 預設 (Default): user_cookies
COOKIES_DIR=user_cookies

# 歷史對話階段存放目錄 (Directory to store session data)
# 用於儲存對話的 session_id 對應的 conversation_id。
# 預設 (Default): output/sessions
SESSIONS_DIR=output/sessions

# 產生的圖片儲存目錄 (Directory to save downloaded images from Gemini)
# 伺服器抓取到的圖片將會存放在此處，並作為 static file 提供存取。
# 預設 (Default): output/image
IMAGE_OUTPUT_DIR=output/image

# ------------------------------------------
# 3. 網路設定 (Network Settings)
# ------------------------------------------

# HTTP 代理伺服器 (HTTP Proxy URL)
# 範例 (Example): http://127.0.0.1:7890
# HTTP_PROXY=

# HTTPS 代理伺服器 (HTTPS Proxy URL)
# 範例 (Example): http://127.0.0.1:7890
# HTTPS_PROXY=
